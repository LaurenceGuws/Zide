<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/product_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/shell_output_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#10161d"
            android:fillViewport="true">

            <TextView
                android:id="@+id/shell_output_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="#f5f7fa"
                android:textSize="13sp"
                android:typeface="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ime_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_ime" />

            <Button
                android:id="@+id/shell_restart_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/shell_restart_short" />

            <Button
                android:id="@+id/view_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/show_debug_short" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/product_surface_container"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:background="#162028" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/debug_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/debug_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_view_title"
                android:textAppearance="@android:style/TextAppearance.Material.Medium" />

            <Button
                android:id="@+id/debug_view_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/show_product_view" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/status_booting"
            android:textAppearance="@android:style/TextAppearance.Material.Medium" />

        <TextView
            android:id="@+id/event_log_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/event_log_label"
            android:textAppearance="@android:style/TextAppearance.Material.Small" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/event_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="8dp"
                android:textAppearance="@android:style/TextAppearance.Material.Small" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shell_input_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#dd10161d"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/shell_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#18222c"
            android:hint="@string/shell_input_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:padding="10dp"
            android:privateImeOptions="disableFullscreenMode=true"
            android:textColor="#f5f7fa"
            android:textColorHint="#5f6f82"
            android:textSize="14sp" />

        <Button
            android:id="@+id/shell_send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/shell_send" />
    </LinearLayout>
</FrameLayout>
