<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161d">

    <LinearLayout
        android:id="@+id/product_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/product_content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/product_surface_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#162028" />

            <ScrollView
                android:id="@+id/shell_output_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/shell_output_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:padding="6dp"
                    android:textColor="#f5f7fa"
                    android:textSize="13sp"
                    android:typeface="monospace" />
            </ScrollView>
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/input_assist_scroll"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0d1319"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/input_assist_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/assist_esc_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_esc" />

                <Button
                    android:id="@+id/assist_tab_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_tab" />

                <Button
                    android:id="@+id/assist_ctrl_c_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="58dp"
                    android:text="@string/assist_ctrl_c" />

                <Button
                    android:id="@+id/assist_ctrl_d_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="58dp"
                    android:text="@string/assist_ctrl_d" />

                <Button
                    android:id="@+id/assist_pipe_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_pipe" />

                <Button
                    android:id="@+id/assist_slash_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_slash" />

                <Button
                    android:id="@+id/assist_up_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_up" />

                <Button
                    android:id="@+id/assist_down_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_down" />

                <Button
                    android:id="@+id/assist_left_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_left" />

                <Button
                    android:id="@+id/assist_right_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_right" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/debug_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/debug_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_view_title"
                android:textAppearance="@android:style/TextAppearance.Material.Medium" />

            <Button
                android:id="@+id/debug_view_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/show_product_view" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/status_booting"
            android:textAppearance="@android:style/TextAppearance.Material.Medium" />

        <TextView
            android:id="@+id/event_log_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/event_log_label"
            android:textAppearance="@android:style/TextAppearance.Material.Small" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/event_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="8dp"
                android:textAppearance="@android:style/TextAppearance.Material.Small" />
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/left_sidebar"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111820"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/sidebar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/sidebar_title"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="#f5f7fa" />

        <Button
            android:id="@+id/sidebar_restart_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shell_restart_short" />

        <Button
            android:id="@+id/sidebar_debug_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_debug_short" />
    </LinearLayout>

    <View
        android:id="@+id/left_edge_swipe_hotspot"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#00000000" />

</FrameLayout>
