<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_shell_root_bg">

    <LinearLayout
        android:id="@+id/product_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/product_content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/product_surface_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/app_shell_surface_bg" />

            <uk.laurencegouws.terminal.scroll.ScrollOverlayView
                android:id="@+id/terminal_scroll_overlay"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/product_readiness_blocker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/app_shell_readiness_overlay_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/product_readiness_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/product_readiness_title_missing"
                    android:textAppearance="@android:style/TextAppearance.Material.Large"
                    android:textColor="@color/app_shell_text_primary" />

                <TextView
                    android:id="@+id/product_readiness_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/product_readiness_detail_missing"
                    android:textAppearance="@android:style/TextAppearance.Material.Small"
                    android:textColor="@color/app_shell_text_secondary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/product_readiness_retry_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_readiness_retry" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/input_assist_scroll"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@color/app_shell_assist_bar_bg"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/input_assist_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/assist_ime_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="56dp"
                    android:text="@string/assist_ime" />

                <Button
                    android:id="@+id/assist_esc_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_esc" />

                <Button
                    android:id="@+id/assist_tab_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_tab" />

                <Button
                    android:id="@+id/assist_ctrl_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="58dp"
                    android:text="@string/assist_ctrl" />

                <Button
                    android:id="@+id/assist_alt_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="58dp"
                    android:text="@string/assist_alt" />

                <Button
                    android:id="@+id/assist_pipe_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_pipe" />

                <Button
                    android:id="@+id/assist_slash_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_slash" />

                <Button
                    android:id="@+id/assist_up_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_up" />

                <Button
                    android:id="@+id/assist_down_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_down" />

                <Button
                    android:id="@+id/assist_left_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_left" />

                <Button
                    android:id="@+id/assist_right_button"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="48dp"
                    android:text="@string/assist_right" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_shell_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/left_sidebar"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_shell_sidebar_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/sidebar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/sidebar_title"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="@color/app_shell_text_primary" />

        <TextView
            android:id="@+id/sidebar_terminal_sessions_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/sidebar_terminal_sessions"
            android:textAppearance="@android:style/TextAppearance.Material.Small"
            android:textColor="@color/app_shell_text_secondary" />

        <Button
            android:id="@+id/product_terminal_tab_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/product_terminal_tab_0" />

        <Button
            android:id="@+id/product_terminal_tab_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/product_terminal_tab_1" />

        <Button
            android:id="@+id/sidebar_restart_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/shell_restart_short" />

        <Button
            android:id="@+id/sidebar_packages_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sidebar_packages" />

        <Button
            android:id="@+id/sidebar_install_test_tools_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sidebar_install_test_tools" />
    </LinearLayout>

    <View
        android:id="@+id/left_edge_swipe_hotspot"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_shell_hotspot_bg" />

</FrameLayout>
